<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.0">
  <!-- comMain — 홈 대시보드 (메인화면). 레거시 comMainPage 이관 데모 -->
  <Form id="comMain" width="1040" height="720" titletext="홈" onload="comMain_onload" background="#f8fafc">
    <Objects>
      <Dataset id="ds_Stats">
        <ColumnInfo>
          <Column id="CUST_CNT" type="STRING" size="20"/>
          <Column id="ACTIVE_CNT" type="STRING" size="20"/>
          <Column id="PROG_CNT" type="STRING" size="20"/>
          <Column id="TOTAL_PROG" type="STRING" size="20"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Static id="sta_Welcome" left="24" top="20" width="600" height="32" text="환영합니다" font="bold 22px"/>
    <Static id="sta_Sub" left="24" top="56" width="800" height="22" text="ai-edu ERP 메인 대시보드 (Nexacro 이관 데모)" color="#64748b"/>
  </Form>
</FDL>
