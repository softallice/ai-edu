<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.0">
  <!-- comLogin — 로그인 (레거시 ComLogin 이관 / 백엔드 com/ComLogin_Login.do 연동) -->
  <Form id="comLogin" left="0" top="0" width="1280" height="800" titletext="로그인"
        onload="comLogin_onload" background="#1f2937">
    <Objects>
      <Dataset id="ds_Login">
        <ColumnInfo>
          <Column id="USER_ID" type="STRING" size="200"/>
          <Column id="PASSWORD" type="STRING" size="200"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_UserInfo">
        <ColumnInfo>
          <Column id="USER_ID" type="STRING" size="200"/>
          <Column id="USER_NM" type="STRING" size="100"/>
          <Column id="ACCOUNT_NO" type="STRING" size="30"/>
          <Column id="ROLE" type="STRING" size="100"/>
          <Column id="TOKEN" type="STRING" size="1000"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Static id="sta_Box" left="440" top="240" width="400" height="300" text="" background="#ffffff"/>
    <Static id="sta_Title" left="470" top="270" width="340" height="40" text="ai-edu ERP 로그인" font="bold 20px"/>
    <Edit id="edt_Id" left="470" top="330" width="340" height="36" taborder="0"
          bind:value="ds_Login.0.USER_ID" placeholder="이메일 (admin@aiedu.local)"/>
    <Edit id="edt_Pw" left="470" top="376" width="340" height="36" taborder="1" displaytype="password"
          bind:value="ds_Login.0.PASSWORD" placeholder="비밀번호 (admin1234)"/>
    <Button id="btn_Login" left="470" top="430" width="340" height="42" taborder="2"
            text="로그인" onclick="btn_Login_onclick"/>
    <Static id="sta_Hint" left="470" top="486" width="340" height="20"
            text="데모: admin@aiedu.local / admin1234" font="12px" color="#6b7280"/>
    <Script type="xscript5.0"><![CDATA[
include "script::lib_script_common.xjs";

this.sPACKAGENAME = "comLogin";

this.comLogin_onload = function(obj, e) { this.fn_Init(); };

this.fn_Init = function()
{
    this.ds_Login.clearData();
    this.ds_Login.addRow();
};

this.fn_Login = function()
{
    if (this.ds_Login.getColumn(0, "USER_ID") == "") { alert("이메일을 입력하세요."); return; }
    this.fnc_TransactionCall("Login", "com/ComLogin_Login.do",
        "ds_Login=ds_Login", "ds_UserInfo=ds_UserInfo", "", "fn_LoginCallback");
};

this.fn_LoginCallback = function(svcID, errCode, errMsg)
{
    if (errCode < 0) { alert("로그인 실패: " + errMsg); return; }
    var app = nexacro.getApplication();
    app.gv_token  = this.ds_UserInfo.getColumn(0, "TOKEN");
    app.gv_userId = this.ds_UserInfo.getColumn(0, "USER_ID");
    app.gv_userNm = this.ds_UserInfo.getColumn(0, "USER_NM");
    app.gfn_openMainFrame();   // 로그인 → 메인 프레임 전환
};

this.btn_Login_onclick = function(obj, e) { this.fn_Login(); };
    ]]></Script>
  </Form>
</FDL>
